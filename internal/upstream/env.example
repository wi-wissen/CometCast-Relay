# SPDX-License-Identifier: GPL-3.0-or-later
# Copy to .env (which is not committed) and edit. Used by docker-compose.yml and
# coturn/render.sh. Host names and addresses below are EXAMPLES.

# The coturn image is pinned by tag and digest in docker-compose.yml (4.18.0, the tag that was run);
# COTURN_VERSION is no longer read.
# User and group the coturn container runs as. A group of its own: render.sh gives turnserver.conf
# (the TURN secret) and certs/privkey.pem to COTURN_GID with mode 640, so every member of that group
# can read them. Never 65534 (nogroup, shared with other host daemons; render.sh refuses it). Check
# that no host user or group has these IDs: getent passwd 3478; getent group 3478
COTURN_UID=3478
COTURN_GID=3478

# Name of the TURN realm (usually the host name of the server).
TURN_REALM=relay.example.org
# Public IP address of this machine (what clients can reach). Behind NAT write
# "public/private", for example 203.0.113.10/10.0.0.5 (private part = TURN_RELAY_IP below).
TURN_EXTERNAL_IP=203.0.113.10
# Optional: make coturn listen only on this local address instead of every address of the host
# (docker-compose.yml uses host networking, so unset means ALL host addresses). Also used by
# the coturn health check.
# TURN_LISTENING_IP=203.0.113.10
# IP address coturn uses for relaying (the "relay IP"). On a machine with one address this
# is the same as the external one, or its private address behind NAT.
# It is the only private/own address that coturn lets peers reach (allowed-peer-ip).
TURN_RELAY_IP=203.0.113.10
# UNCERTAIN: placeholder relay port range. Keep it narrow and open it in the firewall.
# One port per allocation. render.sh sets coturn's total-quota to 80 % of the number of ports,
# so a wider range means a higher cap (and bps-capacity in the template may then be the limit).
TURN_MIN_PORT=49160
TURN_MAX_PORT=49660
