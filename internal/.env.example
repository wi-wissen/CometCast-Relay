# SPDX-License-Identifier: GPL-3.0-or-later
# Copy to .env (not committed) and edit. Used by compose.yaml and coturn/render.sh. Host names and addresses
# below are EXAMPLES. Derived from internal/upstream/env.example (product repository).

# Exact release of ghcr.io/wi-wissen/cometcast-server (no "v", never "latest").
# UNCERTAIN: no release has been published yet; check the tags first.
COMETCAST_VERSION=0.1.0

# Tag of the coturn image. 4.18.0 is the tag that was run (the template depends on the options of 4.18).
COTURN_VERSION=4.18.0

# Name of the TURN realm (usually the host name of the server).
TURN_REALM=relay.example.org
# Public IP address of this machine (what clients can reach). Behind NAT write
# "public/private", for example 203.0.113.10/10.0.0.5 (private part = TURN_RELAY_IP below).
TURN_EXTERNAL_IP=203.0.113.10
# Optional: listen only on this local address (host networking: unset means ALL host addresses).
# Also used by the coturn health check.
# TURN_LISTENING_IP=203.0.113.10
# IP address coturn uses for relaying. The only own address peers may reach (allowed-peer-ip).
TURN_RELAY_IP=203.0.113.10
# UNCERTAIN: placeholder relay port range. Keep it narrow and open it in the firewall.
TURN_MIN_PORT=49160
TURN_MAX_PORT=49660
