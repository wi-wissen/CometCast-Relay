#
# Caddy in front of cometcast-server. Caddy gets and renews the TLS certificate by itself
# (Let's Encrypt; needs ports 80 and 443 reachable and DNS pointing here).
#
# Edit RELAY_DOMAIN in .env (default below), not this file, for your own relay.
{
	# WebSocket upgrades are HTTP/1.1; HTTP/3 (UDP) is not used: HTTP/1.1 and HTTP/2 only.
	servers {
		protocols h1 h2
		# Slow-client limits (slowloris): a request must arrive within these times. No read/write timeout for
		# the whole exchange on purpose: a WebSocket stays open for hours (after the upgrade the connection is
		# hijacked and these server timeouts no longer apply). `idle` closes unused keep-alive connections.
		timeouts {
			read_header 10s
			read_body 10s
			idle 2m
		}
	}
	# Access log: OFF by default (it would record visitors' IP addresses; decide first, see
	# docs/SETUP.md "Abuse handling"). Errors go to the container log, and at error level they DO contain
	# the client address (for example a failed proxy request); see docs/SETUP.md 10.1 for what is logged.
}

{$RELAY_DOMAIN:relay.cometcast.de} {
	header -Server
	# HTTPS only for a year (browsers that visited once refuse plain HTTP for this name). No includeSubDomains and
	# no preload: other names under cometcast.de are not decided here.
	header Strict-Transport-Security "max-age=31536000"

	route {
		# Operator-maintained block list (empty by default). See config/caddy.d/blocklist.caddy.example.
		# A syntax error in a file there stops Caddy at the next start: scripts/up.sh and
		# scripts/reload-caddy.sh run `caddy validate` on it first, so change it with those, not with a blind restart.
		import /etc/caddy/conf.d/*.caddy

		# Only what the relay needs is passed on. The Docker image also contains a copy of the web app and
		# answers every other path with it; the public relay does not offer that (and switches it off in
		# compose.yaml: with no web directory the server itself answers 404 for unknown paths).
		# Caddy path matchers are CASE-INSENSITIVE: /WS and /Healthz match too and are passed on. The server's
		# routes are case-sensitive and, with no web directory, it answers 404 for them (scripts/verify.sh checks
		# that for /WS and /HEALTHZ, and the server directly).
		@relay path /ws /healthz /altcha/challenge /ice-servers
		handle @relay {
			# None of these four routes takes a request body (GET, and the WebSocket handshake): refuse bodies
			# that are not tiny. (The size limit applies to the HTTP request body only, not to WebSocket frames.)
			request_body {
				max_size 4KB
			}
			# Caddy replaces any X-Forwarded-For sent by the client with the address it saw (its default for
			# clients it does not trust; checked locally with a forged header, docs/SETUP.md). The server
			# believes the header only from Caddy's address (network.trusted_proxies). Never add
			# "trusted_proxies" to Caddy's global options unless a CDN really sits in front.
			reverse_proxy cometcast-server:8443
		}

		handle {
			respond "not found" 404
		}
	}
}
