#!/usr/sbin/nft -f
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Host firewall for the relay with nftables (alternative to firewall/ufw.sh; use one of them).
# Own table only: it never flushes the whole ruleset, so Docker's tables stay untouched.
# Check without applying:  nft -c -f firewall/nftables.conf      (as root)
# Apply:                   nft -f firewall/nftables.conf         (as root; keep a second SSH session open)
# Docker note: published container ports (80, 443, 3478/udp) are forwarded, not input, so the "input" chain
# below does not filter them; it protects the host's own services. The per-source rate limit for the published
# STUN port is a separate file, firewall/stun-ratelimit.nft (prerouting, before Docker's NAT); load it too, with
# ufw as well as with this file. Blocking source addresses for 80/443 needs Caddy's block list or the
# DOCKER-USER chain (docs/SETUP.md "Abuse handling").
# Make it permanent: UNCERTAIN, depends on the distribution. On Debian: add
#   include "/etc/nftables-cometcast.conf"
# to /etc/nftables.conf AFTER removing "flush ruleset" there (it would delete Docker's rules), copy this file to
# that path and `systemctl enable nftables`.
#
# SSH is assumed on port 22: change both `22` below if not. STUN is assumed on UDP 3478 (STUN_PORT in .env):
# change the `3478` below (and in stun-ratelimit.nft) if you publish another port.

table inet cometcast_host
flush table inet cometcast_host

table inet cometcast_host {
	chain input {
		type filter hook input priority filter; policy drop;

		ct state invalid drop
		ct state established,related accept
		iif "lo" accept

		# ICMP and ICMPv6 (neighbour discovery needs it)
		ip protocol icmp accept
		meta l4proto ipv6-icmp accept

		# SSH, new connections rate limited
		tcp dport 22 ct state new limit rate 30/minute burst 10 packets accept

		# HTTP (certificate requests, redirect) and HTTPS/WSS
		tcp dport { 80, 443 } accept

		# STUN (UDP only). Docker forwards the published port, so this rule matters only if the STUN
		# server ever runs as a host process; it is here so that a host install is not blocked.
		udp dport 3478 accept
	}
}
