# SPDX-License-Identifier: GPL-3.0-or-later
# Copy to .env (never committed) and edit. Read by docker compose and by the scripts.
# No secrets belong here (secrets live in secrets/, made by scripts/gen-secrets.sh).

# Exact release of ghcr.io/wi-wissen/cometcast-server, without a leading "v" and never "latest".
# UNCERTAIN: no release has been published yet; check the tags at
# https://github.com/wi-wissen/CometCast/pkgs/container/cometcast-server before the first start.
# scripts/update.sh and scripts/rollback.sh change this line.
COMETCAST_VERSION=0.1.0
# The [stun] section of config/relay.toml needs a server release that knows it (product commit "Add STUN
# support to open mode"). UNCERTAIN: the 0.1.0 placeholder may predate it; an older server refuses to start
# with "unknown field `stun`". Use the first release that contains the change.

# Host name of the relay: Caddy requests the certificate for it. For your own relay: your name.
RELAY_DOMAIN=relay.cometcast.de

# Host side of the published ports (80, 443 and the STUN service on UDP 3478). Leave the defaults on a
# real server; they are only changed for tests on a machine where these ports are taken.
#BIND_ADDR=0.0.0.0
#HTTP_PORT=80
#HTTPS_PORT=443
#STUN_PORT=3478
